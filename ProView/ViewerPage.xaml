<Page x:Class="ProView.ViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ProView"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Black"
      Loaded="OnPageLoaded">

    <Page.Resources>
        <!-- 幻灯片移入左侧动画 -->
        <Storyboard x:Name="SlideInLeftStoryboard">
            <DoubleAnimation Storyboard.TargetName="SecondImage"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                           From="-600"
                           To="0"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SecondImage"
                           Storyboard.TargetProperty="Opacity"
                           From="0"
                           To="1"
                           Duration="0:0:0.2"/>
        </Storyboard>

        <!-- 幻灯片移入右侧动画 -->
        <Storyboard x:Name="SlideInRightStoryboard">
            <DoubleAnimation Storyboard.TargetName="SecondImage"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                           From="600"
                           To="0"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SecondImage"
                           Storyboard.TargetProperty="Opacity"
                           From="0"
                           To="1"
                           Duration="0:0:0.2"/>
        </Storyboard>

        <!-- 幻灯片移出左侧动画 -->
        <Storyboard x:Name="SlideOutLeftStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainImage"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                           From="0"
                           To="-600"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainImage"
                           Storyboard.TargetProperty="Opacity"
                           From="1"
                           To="0"
                           Duration="0:0:0.2"/>
        </Storyboard>

        <!-- 幻灯片移出右侧动画 -->
        <Storyboard x:Name="SlideOutRightStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainImage"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                           From="0"
                           To="600"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainImage"
                           Storyboard.TargetProperty="Opacity"
                           From="1"
                           To="0"
                           Duration="0:0:0.2"/>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="RootGrid"
          KeyDown="OnKeyDown"
          PointerWheelChanged="OnPointerWheelChanged"
          AllowDrop="True"
          DragOver="OnDragOver"
          Drop="OnDrop"
          Background="Transparent">
        <!-- 主图片显示区域 -->
        <ScrollViewer x:Name="ImageScroller"
                      ZoomMode="Enabled"
                      HorizontalScrollMode="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden"
                      MinZoomFactor="0.1"
                      MaxZoomFactor="10.0"
                      Background="Transparent"
                      BringIntoViewOnFocusChange="False">
            <!-- 双图片容器用于幻灯片切换 -->
            <Grid x:Name="ImageContainer"
                  Background="Transparent">
                <Image x:Name="MainImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <CompositeTransform/>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="SecondImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <CompositeTransform/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </ScrollViewer>

        <!-- 极简信息提示 (文件名) -->
        <TextBlock x:Name="FileNameText"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,24"
                   FontSize="14"
                   Foreground="#80FFFFFF"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="400"/>
        
        <!-- 导航提示 (图片计数) -->
        <TextBlock x:Name="IndexText"
                   Visibility="Collapsed"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,16,24"
                   FontSize="12"
                   Foreground="#60FFFFFF"/>

        <!-- 打开文件提示 -->
        <StackPanel x:Name="OpenPrompt"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Tapped="OnOpenPromptTapped"
                    IsTapEnabled="True">
            <FontIcon Glyph="&#xEB9F;" 
                      FontSize="64" 
                      Foreground="#40FFFFFF"/>
            <TextBlock Text="按 O 打开图片，或拖放图片到窗口"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="#60FFFFFF"/>
            <TextBlock Text="← → 切换图片  |  滚轮缩放  |  F 全屏"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="#40FFFFFF"/>
        </StackPanel>
    </Grid>
</Page>
